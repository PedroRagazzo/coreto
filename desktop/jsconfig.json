{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    // O pacote "events" (usado pelo site, na raiz do repositório) não pode tomar o lugar do módulo embutido do Node.
    "paths": { "events": ["./node_modules/@types/node/events.d.ts"] }
  },
  "include": ["src", "scripts"]
}
