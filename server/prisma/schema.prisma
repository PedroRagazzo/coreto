// Esquema relacional (PostgreSQL). A URL de conexão fica em prisma.config.ts.
// Presença e estado de voz são efêmeros e ficam fora do banco.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChannelKind {
  TEXT
  VOICE
}

enum OverwriteTarget {
  ROLE
  MEMBER
}

model User {
  id            String               @id @default(uuid())
  displayName   String               @db.VarChar(32)
  /// Nome em minúsculas usado no login; único. Nulo nas contas de antes do PIN.
  loginName     String?              @unique @db.VarChar(32)
  /// "sal:hash" (scrypt, hex) do PIN de 4 dígitos. Nulo = ninguém entra por nome e PIN (robôs, contas antigas).
  pinHash       String?
  avatarColor   String               @db.VarChar(7)
  isBot         Boolean              @default(false)
  createdAt     DateTime             @default(now())
  sessions      Session[]
  ownedSpaces   Space[]              @relation("SpaceOwner")
  memberships   Member[]
  messages      Message[]
  directsAsA    DirectConversation[] @relation("DirectUserA")
  directsAsB    DirectConversation[] @relation("DirectUserB")
  mentions      Mention[]
  uploads       Attachment[]
  reactions     Reaction[]
  pollVotes     PollVote[]
  readStates    ReadState[]
}

/// Sessão de login sem expiração: o navegador fica sempre logado. O banco guarda só o hash SHA-256 do token.
model Session {
  tokenHash String   @id @db.Char(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Comunidade ("Espaço").
model Space {
  id         String     @id @default(uuid())
  name       String     @db.VarChar(100)
  iconUrl    String?
  ownerId    String
  owner      User       @relation("SpaceOwner", fields: [ownerId], references: [id])
  createdAt  DateTime   @default(now())
  roles      Role[]
  categories Category[]
  channels   Channel[]
  members    Member[]
}

/// Cargo. O cargo "@everyone" usa o mesmo id do espaço.
model Role {
  id          String       @id @default(uuid())
  spaceId     String
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String       @db.VarChar(100)
  color       String?      @db.VarChar(7)
  position    Int
  /// Bit flags de shared/src/permissions.ts
  permissions BigInt       @default(0)
  hoist       Boolean      @default(false)
  members     MemberRole[]

  @@index([spaceId])
}

model Member {
  spaceId  String
  userId   String
  nickname String?      @db.VarChar(32)
  joinedAt DateTime     @default(now())
  space    Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles    MemberRole[]

  @@id([spaceId, userId])
  @@index([userId])
}

model MemberRole {
  spaceId String
  userId  String
  roleId  String
  member  Member @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId, roleId])
}

model Category {
  id       String    @id @default(uuid())
  spaceId  String
  space    Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name     String    @db.VarChar(100)
  position Int
  channels Channel[]

  @@index([spaceId])
}

model Channel {
  id         String                @id @default(uuid())
  spaceId    String
  space      Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name       String                @db.VarChar(100)
  kind       ChannelKind
  position   Int
  topic      String?               @db.VarChar(1024)
  overwrites PermissionOverwrite[]
  messages   Message[]

  @@index([spaceId])
}

/// Permissões por canal (ler, escrever, conectar...) para um cargo ou membro.
model PermissionOverwrite {
  channelId  String
  channel    Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  targetType OverwriteTarget
  targetId   String
  allow      BigInt          @default(0)
  deny       BigInt          @default(0)

  @@id([channelId, targetType, targetId])
}

/// Conversa privada entre duas pessoas. `userAId` é sempre o menor dos dois ids,
/// para que o par só possa existir uma vez.
model DirectConversation {
  id            String    @id @default(uuid())
  userAId       String
  userBId       String
  userA         User      @relation("DirectUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User      @relation("DirectUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// Mensagem de um canal de texto (`channelId`) ou de uma conversa direta (`directId`):
/// exatamente um dos dois é preenchido.
model Message {
  /// Em produção, prefira ids ordenáveis por tempo (UUIDv7 ou snowflake) para paginar pelo id.
  id        String              @id @default(uuid())
  channelId String?
  channel   Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  directId  String?
  direct    DirectConversation? @relation(fields: [directId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation(fields: [authorId], references: [id])
  /// Pode ser vazio quando a mensagem tem anexos.
  content     String              @db.VarChar(2000)
  /// `searchKey(content)` (shared/src/search.ts): sem acentos, minúsculo, sem menções.
  searchText  String              @default("")
  createdAt   DateTime            @default(now())
  editedAt    DateTime?
  /// A mensagem a que esta responde. Sem chave estrangeira de propósito: apagar a original não apaga as respostas,
  /// e o servidor mostra "mensagem apagada" quando não a encontra.
  replyToId   String?
  mentions    Mention[]
  attachments Attachment[]
  reactions   Reaction[]
  /// Preenchido quando a mensagem é uma enquete (o `content` é a pergunta) ou uma roleta (o `content` é o título).
  poll        Poll?
  roulette    Roulette?

  @@index([channelId, createdAt(sort: Desc)])
  @@index([directId, createdAt(sort: Desc)])
  /// Busca por trecho (`LIKE '%palavra%'`) com a extensão pg_trgm.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Até onde a pessoa já leu um canal de texto ou uma conversa direta: o que outras pessoas escreveram depois
/// disso é "não lido". Sem chave estrangeira em `channelId` porque o lugar pode ser um canal ou uma conversa.
model ReadState {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId  String
  lastReadAt DateTime

  @@id([userId, channelId])
}

/// Uma pessoa reagiu a uma mensagem com um emoji. Some junto com a mensagem.
/// A enquete de uma mensagem. Apagar a mensagem apaga a enquete, as opções e os votos.
model Poll {
  messageId String       @id
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Cada pessoa pode votar em mais de uma opção.
  multiple  Boolean      @default(false)
  /// Quando foi encerrada; encerrada não aceita votos.
  closedAt  DateTime?
  options   PollOption[]
}

model PollOption {
  id       String     @id @default(uuid())
  pollId   String
  poll     Poll       @relation(fields: [pollId], references: [messageId], onDelete: Cascade)
  position Int
  text     String     @db.VarChar(100)
  votes    PollVote[]

  @@index([pollId, position])
}

model PollVote {
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([optionId, userId])
  /// Os votos de uma pessoa, para tirar o anterior numa enquete de uma resposta só.
  @@index([userId])
}

/// A roleta de uma mensagem. O servidor sorteia a opção, uma vez só.
model Roulette {
  messageId   String    @id
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options     String[]
  /// Posição da opção sorteada em `options`; nulo enquanto ninguém girou.
  resultIndex Int?
  spunAt      DateTime?
  /// Quem girou. Sem chave estrangeira de propósito: só serve para mostrar o nome.
  spunById    String?
}

model Reaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Um único emoji (shared/src/emoji.ts confere).
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  /// Mostra as reações de uma mensagem na ordem em que cada emoji apareceu.
  @@index([messageId, createdAt])
}

/// Menção ainda não vista: `<@id>` numa mensagem de canal. Some quando a pessoa abre o canal.
model Mention {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Canal da mensagem, repetido para contar sem juntar tabelas.
  channelId String
  createdAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId, channelId])
}

/// Imagem enviada. O arquivo fica em disco (UPLOAD_DIR/<id>); sem `messageId`,
/// ainda não foi usada numa mensagem e é apagada depois de um tempo.
model Attachment {
  id          String   @id @default(uuid())
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Ordem dentro da mensagem.
  position    Int      @default(0)
  uploaderId  String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  fileName    String   @db.VarChar(255)
  contentType String   @db.VarChar(50)
  size        Int
  /// Dimensões da imagem; nulas quando o anexo é um arquivo qualquer.
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  @@index([messageId])
  @@index([uploaderId, messageId])
}
