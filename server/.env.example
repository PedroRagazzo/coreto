# Copie para server/.env e ajuste usuário, senha, porta e nome do banco.
# `npm run db:migrate` cria o banco "coreto" se ele ainda não existir.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/coreto"

# Banco dos testes de integração (npm test). Eles APAGAM este banco a cada execução,
# por isso o nome precisa terminar em _test. Sem esta linha, só os testes unitários rodam.
# TEST_DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/coreto_test"

# Pasta das imagens enviadas (padrão: server/uploads).
# UPLOAD_DIR="uploads"

# Voz atrás de NAT restrito precisa de um servidor TURN. Com coturn em
# `use-auth-secret`, o servidor gera credenciais temporárias por usuário:
# TURN_URLS="turn:turn.exemplo.com:3478,turns:turn.exemplo.com:5349"
# TURN_SECRET="o mesmo static-auth-secret do coturn"
# TURN_TTL_SECONDS="86400"
# Para testar o TURN, force todo o áudio por ele:
# ICE_TRANSPORT_POLICY="relay"
# Servidores ICE fixos (JSON); o padrão é o STUN público do Google:
# ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
